# Copia este archivo a server/.env y rellena los valores.
# (wsl-up.sh lo crea automaticamente con un secreto aleatorio si no existe)

# Con Docker Compose se sobrescribe a mongodb://mongo:27017/easytunr
MONGO_URI=mongodb://localhost:27017/easytunr

# Secreto para firmar los JWT (>= 32 caracteres). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Vida del access token en segundos
JWT_ACCESS_TOKEN_EXPIRES_SECONDS=600

# 1 = modo debug de Flask (solo con `python server.py`, nunca en produccion)
FLASK_DEBUG=0
